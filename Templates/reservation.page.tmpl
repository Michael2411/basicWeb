{{template "base" .}}
{{define "headers"}}
<title>Reservation</title>

{{end}}
{{define "content"}}


<div class="container">
    <div class="row">
        <div class="col-md-3"></div>
        <div class="col-md-6">
            <h1>Search For Availability</h1>
            <form id="myForm" action="/reserve" method="post" novalidate class="needs-validation">
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="startDate" class="form-label">Arrival</label>
                            <div class="input-group">
                                <input required type="text" class="form-control date-picker" id="startDate"
                                    name="start_date" aria-describedby="dateHelp" placeholder="YYYY-MM-DD">
                                <span class="input-group-text calendar-icon">
                                    <i class="bi bi-calendar"></i> <!-- Bootstrap Icons -->
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="endDate" class="form-label">Departure</label>
                            <div class="input-group">
                                <input required type="text" class="form-control date-picker" id="endDate"
                                    name="end_date" aria-describedby="enddateHelp" placeholder="YYYY-MM-DD">
                                <span class="input-group-text calendar-icon">
                                    <i class="bi bi-calendar"></i> <!-- Bootstrap Icons -->
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 form-check">
                        <input required type="checkbox" class="form-check-input" id="checkBox">
                        <label class="form-check-label" for="checkBox">I agree that I will not misuse or damage the
                            property</label>
                    </div>
                    <button type="submit" class="btn btn-primary" id="SubmitButton">Search Availability</button>
                </div>
            </form>
        </div>
    </div>
</div>
{{end}}

{{define "js"}}
 <!-- This Script is used for the search Availability in Reservation page -->
 <script>
    

    document.addEventListener('DOMContentLoaded', function () {
      // Select start date and end date inputs
      const startDateInput = document.getElementById('startDate');
      const endDateInput = document.getElementById('endDate');

      // Initialize Flatpickr for both start and end date inputs
      flatpickr(startDateInput, {
        dateFormat: "Y-m-d",
        onChange: function (selectedDates, dateStr, instance) {
          console.log(`Start Date selected: ${dateStr}`);
          // Set minimum date for end date to be equal or later than the start date
          endDateInput._flatpickr.set('minDate', dateStr);
        }
      });

      flatpickr(endDateInput, {
        dateFormat: "Y-m-d",
        onChange: function (selectedDates, dateStr, instance) {
          console.log(`End Date selected: ${dateStr}`);
        }
      });

      // Open Flatpickr on calendar icon click
      const icons = document.querySelectorAll('.calendar-icon');
      icons.forEach(icon => {
        icon.addEventListener('click', function () {
          const input = this.previousElementSibling; // Target the input field
          input._flatpickr.open(); // Open Flatpickr
        });
      });

      // Custom validation for the date range
      const form = document.getElementById('myForm');
      form.addEventListener('submit', function (event) {
        // Ensure both dates are filled
        if (!startDateInput.value || !endDateInput.value) {
          if (!startDateInput.value) startDateInput.classList.add('is-invalid');
          if (!endDateInput.value) endDateInput.classList.add('is-invalid');
          event.preventDefault();
          event.stopPropagation();
        } else {
          startDateInput.classList.remove('is-invalid');
          endDateInput.classList.remove('is-invalid');
          startDateInput.classList.add('is-valid');
          endDateInput.classList.add('is-valid');
        }

        form.classList.add('was-validated'); // Apply Bootstrap styles
      });
    });



    // // Success notification
    // function showToastSuccess() {
    //   Toastify({
    //     text: "Your action was successful!",
    //     backgroundColor: "linear-gradient(to right, #00b09b, #96c93d)", // Green color for success
    //     className: "info", // Class for info messages
    //     position: "right",
    //     duration: 3000
    //   }).showToast();
    // }

  </script>
  {{end}}
