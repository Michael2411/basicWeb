<script>
  function promptMessage() {
    let errorMessage = function () {
      let alertMessage = "Please Enter All Required Data"
      let color = "linear-gradient(to right, #ff5f6d, #ffc3a0)"
      let alertType = "error"
      showToastMessage(alertMessage, color, alertType)
    }

    let successMessage = function () {
      let alertMessage = "Your action was successful!"
      let color = "linear-gradient(to right, #00b09b, #96c93d)"
      let alertType = "info"
      showToastMessage(alertMessage, color, alertType)
    }

    return {
      errorMessage: errorMessage,
      successMessage: successMessage,
    }
  }


  // General Notification using toastify
  function showToastMessage(message, color, type) {
    Toastify({
      text: message,
      backgroundColor: color, // Red color for error
      className: type, // Class for error messages
      position: "center",
      duration: 3000
    }).showToast();
  }

  
  (() => {
    'use strict'
    // Fetch all the forms we want to apply custom Bootstrap validation styles to
    const forms = document.querySelectorAll('.needs-validation')
    console.log("got form")
    let notificationMessage = promptMessage()
    // Loop over them and prevent submission
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
          notificationMessage.errorMessage()
        } else {
          notificationMessage.successMessage()
        }

        form.classList.add('was-validated')
      }, false)
    })
  })()

  // This script is used for a general popout inputs if needed
  //popout form using sweetalert2
  async function popUpInput(output) {
    const {
      msg = "",
      title = "",
    } = output

    const { value: result } = await Swal.fire({
      title: title,
      html: msg,
      backdrop: false,
      focusConfirm: false,
      showCancelButton: true,
      willOpen: () => {
       if(output.willOpen !== undefined){
         output.willOpen();
       }
      },
      // do things after the popout is opened
      didOpen: () => {
        if(output.didOpen !== undefined){
         output.didOpen();
       }
      },
      preConfirm: () => {
        if(output.preConfirm !== undefined){
         output.preConfirm();
       }
      }
    });
    if (result) {
      if (result.dismiss !== Swal.DismissReason.cancel) {
        if (result.value !== "") {
          if (output.callback !== undefined) {
            output.callback(result);

          }
        } else {
          output.callback(false)
        }
      } else {
        output.callback(false)
      }
    }

  }
  

</script>

<!-- error when re-routing pages-->
{{with .Error}}
    <script>
      showToastMessage("{{.}}","linear-gradient(to right, #ff5f6d, #ffc3a0)","error")
    </script>
{{end}}
{{with .FlashMessage}}
    <script>
      showToastMessage("{{.}}","linear-gradient(to right, #00b09b, #96c93d)","success")
    </script>
{{end}}
{{with .Warning}}
    <script>
      showToastMessage("{{.}}","","warning")
    </script>
{{end}}


