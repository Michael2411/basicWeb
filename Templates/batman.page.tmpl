{{template "base" .}}
{{define "headers"}}
<title>About Page</title>
{{end}}
{{define "content"}}

<div class="container">
    <div class="row">
        <div class="col">
            <h1>This is Batman Room</h1>
            <img src="/static/Images/batman.jfif" class="img-fluid img-thumbnail mx-auto d-block room-image">
        </div>
    </div>
</div>

<div class="row">
    <div class="col text-center">
        <button type="button" id="reservationButton" class="btn btn-primary">Reserve Room</button>
    </div>
</div>
{{end}}

{{define "js"}}
<script>
    document.getElementById("reservationButton").addEventListener("click", function () {
        let html = `
        <form id="makeReservation" action="" method="post" novalidate class="needs-validation">
    <div class="row"> <!-- Bootstrap row for aligning inputs -->
        <div class="col-md-6"> <!-- First column -->
            <input disabled required class="form-control" type="text" name="start" id="start" placeholder="Arrival">
        </div>
        <div class="col-md-6"> <!-- Second column -->
            <input disabled required class="form-control" type="text" name="end" id="end" placeholder="Departure">
        </div>
    </div>
</form>
        `;
        popUpInput({ msg: html, title: "Select Arrival and Departure Dates" })
    })
</script>
{{end}}